;;;; -*- mode:lisp -*-
;;;; ALPM system definition for AUTOLISP-GEOMETRY.
;;;; Usage: (alpm-register-directory "/path/to/outils-autolisp")
;;;;        (alpm-load-system "autolisp-geometry")
(alpm-define-system 1
 '(name        "autolisp-geometry"
   version     "1.9.4"
   description "4x4 transformation matrices for AutoLISP (construction, ActiveX conversion, composition, decomposition)."
   encoding    "utf-8"
   pathname    "src"
   files       ("autolisp-geometry")))
