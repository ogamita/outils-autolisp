;;;; -*- mode:lisp -*-
;;;; ergo project file for autolisp-hash-table (a sub-project of outils-autolisp).
;;;; Build/load it with:  ergo build   (in this directory)
;;;; or depend on it from another project via the outils-autolisp repo.
(ergo:project
 :designator   (git "git@gitlab.com:pjb-cimon/outils-autolisp.git")
 :dependencies ()
 :build (alpm "autolisp-hash-table")
 :load  (alpm "autolisp-hash-table")
 :name        "autolisp-hash-table"
 :description "Hash tables inspired by Common Lisp.")
