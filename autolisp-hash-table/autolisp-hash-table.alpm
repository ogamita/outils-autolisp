;;;; -*- mode:lisp -*-
;;;; ALPM system definition for AUTOLISP-HASH-TABLE.
;;;; Usage: (alpm-register-directory "/path/to/outils-autolisp")
;;;;        (alpm-load-system "autolisp-hash-table")
(alpm-define-system 1
 '(name        "autolisp-hash-table"
   version     "1.9.3"
   description "Hash tables inspired by Common Lisp."
   encoding    "utf-8"
   pathname    "src"
   files       ("autolisp-hash-table")))
