;;;; -*- mode:lisp -*-
;;;; ergo project file for autolisp-defstruct (a sub-project of outils-autolisp).
;;;; Build/load it with:  ergo build   (in this directory)
;;;; or depend on it from another project via the outils-autolisp repo.
(ergo:project
 :designator   (git "git@gitlab.com:pjb-cimon/outils-autolisp.git")
 :dependencies ()
 :build (alpm "autolisp-defstruct")
 :load  (alpm "autolisp-defstruct")
 :name        "autolisp-defstruct"
 :description "Common Lisp style defstruct for AutoLISP.")
