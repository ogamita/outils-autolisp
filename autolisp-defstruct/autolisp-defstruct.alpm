;;;; -*- mode:lisp -*-
;;;; ALPM system definition for AUTOLISP-DEFSTRUCT.
;;;; Usage: (alpm-register-directory "/path/to/outils-autolisp")
;;;;        (alpm-load-system "autolisp-defstruct")
(alpm-define-system 1
 '(name        "autolisp-defstruct"
   version     "1.9.1"
   description "Common Lisp style defstruct for AutoLISP."
   encoding    "utf-8"
   files       ("defstruct")))
