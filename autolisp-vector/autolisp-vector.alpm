;;;; -*- mode:lisp -*-
;;;; ALPM system definition for AUTOLISP-VECTOR.
;;;; Usage: (alpm-register-directory "/path/to/outils-autolisp")
;;;;        (alpm-load-system "autolisp-vector")
(alpm-define-system 1
 '(name        "autolisp-vector"
   version     "1.9.1"
   description "Tree-backed vector implementation for AutoLISP."
   encoding    "utf-8"
   pathname    "src"
   files       ("autolisp-vector")))
