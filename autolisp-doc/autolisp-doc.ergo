;;;; -*- mode:lisp -*-
;;;; ergo project file for autolisp-doc (a sub-project of outils-autolisp).
;;;; Build/load it with:  ergo build   (in this directory)
;;;; or depend on it from another project via the outils-autolisp repo.
(ergo:project
 :designator   (git "git@gitlab.com:pjb-cimon/outils-autolisp.git")
 :dependencies ()
 :build (alpm "autolisp-doc")
 :load  (alpm "autolisp-doc")
 :name        "autolisp-doc"
 :description "AutoLISP reference data (autolisp-ref) and documentation helpers.")
