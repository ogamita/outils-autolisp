;;;; -*- mode:lisp -*-
;;;; ALPM system definition for AUTOLISP-INTROSPECTION.
;;;; Usage: (alpm-register-directory "/path/to/outils-autolisp")
;;;;        (alpm-load-system "autolisp-introspection")
(alpm-define-system 1
 '(name        "autolisp-introspection"
   version     "1.9.0"
   description "Drawing entity introspection (entity data snapshots) for AutoLISP."
   encoding    "utf-8"
   pathname    "src"
   files       ("autolisp-introspection")))
