;;;; -*- mode:lisp -*-
;;;; ALPM system definition for AUTOLISP-FORMATTER.
;;;; Usage: (alpm-register-directory "/path/to/outils-autolisp")
;;;;        (alpm-load-system "autolisp-formatter")
(alpm-define-system 1
 '(name        "autolisp-formatter"
   description "Source-to-source AutoLISP pretty-printer (cl / nail paren styles)."
   encoding    "utf-8"
   pathname    "src"
   files       ("fmt-util" "fmt-scanner" "fmt-parser" "fmt-options"
                "fmt-io" "fmt-case" "fmt-rules" "fmt-printer" "fmt-main")))
