;;;; -*- mode:lisp -*-
;;;; ergo project file for autolisp-formatter (a sub-project of outils-autolisp).
;;;; Build/load it with:  ergo build   (in this directory)
;;;; or depend on it from another project via the outils-autolisp repo.
(ergo:project
 :designator   (git "git@gitlab.com:pjb-cimon/outils-autolisp.git")
 :dependencies ()
 :build (alpm "autolisp-formatter")
 :load  (alpm "autolisp-formatter")
 :name        "autolisp-formatter"
 :description "Source-to-source AutoLISP pretty-printer (cl / nail paren styles).")
