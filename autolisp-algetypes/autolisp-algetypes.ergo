;;;; -*- mode:lisp -*-
;;;; ergo project file for autolisp-algetypes (a sub-project of outils-autolisp).
;;;; Build/load it with:  ergo build   (in this directory)
;;;; or depend on it from another project via the outils-autolisp repo.
(ergo:project
 :designator   (git "git@gitlab.com:pjb-cimon/outils-autolisp.git")
 :dependencies ()
 :build (alpm "autolisp-algetypes")
 :load  (alpm "autolisp-algetypes")
 :name        "autolisp-algetypes"
 :description "Small immutable algebraic data types for AutoLISP.")
