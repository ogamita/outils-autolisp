;;;; -*- mode:lisp -*-
;;;; ALPM system definition for AUTOLISP-ALGETYPES.
;;;; Usage: (alpm-register-directory "/path/to/outils-autolisp")
;;;;        (alpm-load-system "autolisp-algetypes")
(alpm-define-system 1
 '(name        "autolisp-algetypes"
   version     "1.9.1"
   description "Small immutable algebraic data types for AutoLISP."
   encoding    "utf-8"
   pathname    "src"
   files       ("autolisp-algetypes")))
